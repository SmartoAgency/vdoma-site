mixin thank-you-popup(attr)
  .modal-form(data-ty-popup).hidden
    .form-gradient 
    picture.form-pattern 
      source(srcset="/src/shared/images/form-pattern-mob.png" media="(max-width: 1024px)")
      source(srcset="/src/shared/images/form-pattern.png" media="(min-width: 1024px)")
      img(src="/src/shared/images/form-pattern.png", alt="form-pattern")
    .close-btn(data-call-us-modal-close) 
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M0.928711 2.34375L8.58496 10.001L0.928711 17.6592L2.34277 19.0732L9.99902 11.415L17.6562 19.0732L18.3643 18.3662L19.0713 17.6592L11.4131 10.001L19.0713 2.34375L18.3643 1.63672L17.6562 0.929688L9.99902 8.58691L2.34277 0.929688L0.928711 2.34375Z" fill="#27292B"/>
      </svg>
    h2.thank-you-popup__title ДЯКУЄМО ЗА  <br> ЗВЕРНЕННЯ
    p.thank-you-popup__subtitle Ми зв’яжемось з вами найближчим часом для уточнення деталей!

    
    img(src="/src/shared/images/ty.png", alt="ty").thank-you-popup__img

    button(type="button" data-call-us-modal-close).general-btn.general-btn--dark
      span Закрити повідомлення