extends /../index.pug

block variable
  -
    var title_page = 'progress'
    var id_page = 'id-page-progress'

block meta
  title= title_page
  meta(name='description', content='')

block header
  +header() 

block content
  section.home-progress
    .home-progress__head.container
      h2.section-title(style="margin-left: auto; margin-right: auto;") Будівництво
    .home-progress__slider-wrap
      .swiper.home-progress__swiper
        .swiper-wrapper
          .swiper-slide.home-progress__slide(data-report="report-1")
            .home-progress__photo
              img(src="/src/shared/images/progress-1.jpg", alt="Звіт 01")
              p.home-progress__date 10 СІЧНЯ 2026
          .swiper-slide.home-progress__slide(data-report="report-2")
            .home-progress__photo
              img(src="/src/shared/images/gallery-2.jpg", alt="Звіт 02")
              p.home-progress__date 26 СІЧНЯ 2026
          .swiper-slide.home-progress__slide(data-report="report-3")
            .home-progress__photo
              img(src="/src/shared/images/progress-2.jpg", alt="Звіт 03")
              p.home-progress__date 10 ЛЮТОГО 2026
          .swiper-slide.home-progress__slide(data-report="report-4")
            .home-progress__photo
              img(src="/src/shared/images/gallery-4.jpg", alt="Звіт 04")
              p.home-progress__date 20 ЛЮТОГО 2026
          .swiper-slide.home-progress__slide(data-report="report-5")
            .home-progress__photo
              img(src="/src/shared/images/progress-2.png", alt="Звіт 05")
              p.home-progress__date 01 БЕРЕЗНЯ 2026
      .home-progress__scrollbar-wrap.container
        .home-progress__scrollbar

    .home-progress__reports(aria-hidden="true")
      a.home-progress__report-link(data-report-id="report-1", href="./assets/images/progress-1.jpg", data-caption="Звіт 01")
      a.home-progress__report-link(data-report-id="report-1", href="./assets/images/progress-2.jpg", data-caption="Звіт 01")
      a.home-progress__report-link(data-report-id="report-1", href="./assets/images/gallery-1.jpg", data-caption="Звіт 01")

      a.home-progress__report-link(data-report-id="report-2", href="./assets/images/gallery-2.jpg", data-caption="Звіт 02")
      a.home-progress__report-link(data-report-id="report-2", href="./assets/images/gallery-3.jpg", data-caption="Звіт 02")
      a.home-progress__report-link(data-report-id="report-2", href="./assets/images/progress-1.jpg", data-caption="Звіт 02")

      a.home-progress__report-link(data-report-id="report-3", href="./assets/images/progress-2.jpg", data-caption="Звіт 03")
      a.home-progress__report-link(data-report-id="report-3", href="./assets/images/gallery-4.jpg", data-caption="Звіт 03")
      a.home-progress__report-link(data-report-id="report-3", href="./assets/images/gallery-5.jpg", data-caption="Звіт 03")

      a.home-progress__report-link(data-report-id="report-4", href="./assets/images/gallery-4.jpg", data-caption="Звіт 04")
      a.home-progress__report-link(data-report-id="report-4", href="./assets/images/gallery-6.jpg", data-caption="Звіт 04")
      a.home-progress__report-link(data-report-id="report-4", href="./assets/images/progress-2.png", data-caption="Звіт 04")

      a.home-progress__report-link(data-report-id="report-5", href="./assets/images/progress-2.png", data-caption="Звіт 05")
      a.home-progress__report-link(data-report-id="report-5", href="./assets/images/gallery-1.jpg", data-caption="Звіт 05")
      a.home-progress__report-link(data-report-id="report-5", href="./assets/images/gallery-2.jpg", data-caption="Звіт 05")

block footer
  +footer()

block scripts
  script(type="module" src="/src/pages/progress/progress.js")
